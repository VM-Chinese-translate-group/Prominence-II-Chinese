	quest_links: [ ]
	quests: [
		{
			dependencies: ["04AF2E026BB918AE"]
			description: [
				"&cFinish all chapters of Void's Invasion to unlock this expansion's story line."
				""
				"&8English"
				""
				"{@pagebreak}"
				"&cTermina todos los capitulos de Void's Invasion para desbloquear la campaña de esta expansión."
				""
				"&8Español"
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "eldritch_end:textures/mob_effect/hastur_presence.png"
				}
			}
			id: "73DA5990952CEA35"
			rewards: [{
				advancement: "prominent:level_50"
				auto: "invisible"
				criterion: ""
				id: "1D56AC4A22CDB24A"
				title: "&eUnlock 51-65 Leveling"
				type: "advancement"
			}]
			shape: "diamond"
			size: 1.5d
			subtitle: "&8[Click to read instructions]"
			tasks: [{
				advancement: "prominent:end_of_voids_invasion"
				criterion: ""
				id: "190537CB8ABEDC05"
				title: "&dFinish the Void's Invasion Campaign"
				type: "advancement"
			}]
			title: "&eThe Hasturian Era"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["73DA5990952CEA35"]
			description: [
				"&7&oEons ago, S'kellak fought against the eldritch beings, defeating and imprisoning the primordial being C'thulhu."
				""
				"&7&oWhile its followers escaped, the chains imprisoning its half-brother, a tall hooded monster with tentacles, were broken free. S'kellak couldn't stop his escape, and for eons he never saw him again."
				""
				"&8(1/2)"
				"{@pagebreak}"
				"&7&oUntil now, after the attempt at domination from the remaining forces of the void, all realms lie the weakest they've been."
				""
				"&e&oThe King in Yellow is back, and won't stop until all realms succumb to his new reign."
				""
				"&8(2/2)"
			]
			hide_until_deps_complete: true
			hide_until_deps_visible: true
			icon: "ftbquests:book"
			id: "579138B8DB19724C"
			shape: "diamond"
			size: 1.25d
			subtitle: "&8[Click to Read Lore]"
			tasks: [{
				id: "3E72FE8109B34FDF"
				title: "Continue"
				type: "checkmark"
			}]
			title: "&6&lChapter I: &e&lThe Shadow Beneath the Horizon"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["579138B8DB19724C"]
			description: [
				"&8The missive reads:"
				""
				"&7&o\"Champion, this is urgent."
				""
				"&7&oI have confirmed that it's him, the primordial being of all unholy things, known as Hastur."
				""
				"&7&oI can feel his presence close, we need all of our defenses ready, Vaaz might be in danger."
				""
				"&7&oCome here as soon as you can. We need you, Flameborn."
				""
				"&7&oYou should also enchant your weapon with Smite, Hastur's followers are undead. You should be prepared for the worst.\""
			]
			hide_until_deps_complete: true
			hide_until_deps_visible: true
			icon: "soulsweapons:blood_vial_recipe_page"
			id: "440126C71C47DB94"
			shape: "octagon"
			subtitle: "&8[Click to Read Missive]"
			tasks: [{
				icon: "prominent:flameborn_stone"
				id: "449870D454BEB253"
				title: "Use the Flameborn Stone and go to Vaaz"
				type: "custom"
			}]
			title: "&eUrgent Missive from S'kellak"
			x: 0.5d
			y: 1.5d
		}
		{
			dependencies: ["440126C71C47DB94"]
			description: [
				"&eRequired Level: 60"
				""
				"&7The once archmage and leader of the Hex, dead in the hands of the Champions of Vaaz, was been resurrected by Hastur himself."
