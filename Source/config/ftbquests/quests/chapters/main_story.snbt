				}
			]
			shape: "pentagon"
			size: 1.5d
			subtitle: "&8[Click to read lore and indications]"
			tasks: [
				{
					entity: "spellbladenext:magus"
					icon: {
						Count: 1
						id: "ftbquests:custom_icon"
						tag: {
